# ─────────────────────────────────────────────────────────────────────────────
# ImmoRadar — omgevingsvariabelen
#
# Kopieer naar .env en vul aan. Alles met een zinnige standaardwaarde mag weg;
# alleen DATABASE_URL is altijd verplicht. In productie komt SESSION_SECRET daar
# hard bij (src/lib/env.ts weigert anders te starten).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Met docker compose up -d:
DATABASE_URL="postgresql://immoradar:immoradar@localhost:5432/immoradar?schema=public"
# Met npm run dev:db (embedded PostgreSQL, geen Docker nodig):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5435/immoradar?schema=public"

# Max. verbindingen per proces (web en worker hebben elk hun eigen pool).
DATABASE_POOL_MAX="10"

# ── Sessies ──────────────────────────────────────────────────────────────────
# Minstens 32 tekens. Genereer met: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
SESSION_TTL_HOURS="12"

# ── Inlogbeveiliging ─────────────────────────────────────────────────────────
# Na LOGIN_MAX_ATTEMPTS foute pogingen op rij gaat een account LOGIN_LOCK_MINUTES
# op slot; elke volgende reeks verdubbelt (tot een dag). Daarnaast een plafond per
# IP-adres per kwartier, tegen het uitproberen van veel accounts tegelijk.
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCK_MINUTES="15"
LOGIN_MAX_ATTEMPTS_PER_IP="30"
# Aantal reverse proxies vóór de app die X-Forwarded-For aanvullen (Render/Fly/
# load balancer: 1). Bepaalt welk adres als client-IP telt; 0 = header negeren.
TRUSTED_PROXY_HOPS="1"

# ── Eerste platformbeheerder (npm run bootstrap:admin) ───────────────────────
# Alleen nodig bij de eerste installatie; het script doet niets als het adres al bestaat.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""

# ── Telegram ─────────────────────────────────────────────────────────────────
# Leeg laten = alerts worden wél aangemaakt en getoond, maar niet verstuurd
# (status SUPPRESSED_DRY_RUN). Zo is de alertlaag te demonstreren zonder bot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_FALLBACK_CHAT_ID=""

# ── Classificatie ────────────────────────────────────────────────────────────
PRIVATE_CONFIDENCE_THRESHOLD="0.85"
PROFESSIONAL_LISTING_COUNT_THRESHOLD="4"

# ── Property matching ────────────────────────────────────────────────────────
PROPERTY_MATCH_THRESHOLD="0.78"
PROPERTY_MATCH_REVIEW_THRESHOLD="0.55"

# ── CRM ↔ markt matching ─────────────────────────────────────────────────────
# Boven AUTO koppelen we automatisch, tussen REVIEW en AUTO tonen we de match
# als "te bevestigen", daaronder bestaat hij niet.
CRM_MATCH_AUTO_THRESHOLD="0.80"
CRM_MATCH_REVIEW_THRESHOLD="0.55"

# ── LeadRevive ───────────────────────────────────────────────────────────────
# Na hoeveel maanden stilte een contact dormant heet.
DORMANT_MONTHS="12"
# Minimale relatiescore voordat een dormant contact een kans wordt.
MIN_RELATIONSHIP_SCORE="45"

# ── Event detection ──────────────────────────────────────────────────────────
STALE_THRESHOLD_DAYS="30,60,90"
PRICE_CHANGE_MIN_PERCENT="0.5"
COLLECTOR_MISSING_RUNS_BEFORE_REMOVED="3"
RELIST_WINDOW_DAYS="365"

# ── Opportunities ────────────────────────────────────────────────────────────
MIN_OPPORTUNITY_SCORE="40"
OPPORTUNITY_TTL_DAYS="30"
HIGH_VALUE_THRESHOLD="600000"

# ── Collectors ───────────────────────────────────────────────────────────────
# Lege lijst = geen enkele bron draait. Bewust: een vergeten variabele levert
# een stille worker op in plaats van onbedoeld verkeer naar externe sites.
COLLECTOR_ENABLED_SOURCES="fixture-be,demo-be"
COLLECTOR_USER_AGENT="ImmoRadarBot/0.1 (+https://example.be/bot; contact@example.be)"
COLLECTOR_MAX_REQUESTS_PER_MINUTE="20"
COLLECTOR_HTTP_TIMEOUT_MS="15000"
COLLECTOR_COOLDOWN_MINUTES="30"
COLLECTOR_CONCURRENCY="3"
COLLECTOR_MAX_ITEMS_PER_RUN="500"
DEMO_TICK_MINUTES="5"

# ── Bewaartermijnen (dagen) ──────────────────────────────────────────────────
RETENTION_SELLER_CONTACT_DAYS="180"
RETENTION_RAW_PAYLOAD_DAYS="14"
RETENTION_REMOVED_LISTING_DAYS="730"
RETENTION_CRM_CONTACT_DAYS="3650"   # 0 = uit; korter dan 1825 wist "eerdere kopers"
RETENTION_IMPORT_ROWS_DAYS="90"     # ruwe CSV-kolommen per importregel

# ── Overig ───────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
CRON_SECRET=""
# In productie verplicht https:// (de app weigert anders te starten).
APP_BASE_URL="http://localhost:3000"

# ── Juridische identiteit ────────────────────────────────────────────────────
# Verschijnt in /privacy en /voorwaarden. Vul adres en contactadres in vóór de
# lancering; zonder contactadres kan niemand zijn privacyrechten uitoefenen.
LEGAL_ENTITY_NAME="Marhaba Data & AI Agent BV"
LEGAL_ENTITY_VAT="BE1003552102"
LEGAL_ENTITY_ADDRESS=""
LEGAL_CONTACT_EMAIL=""

# ── Alleen voor wegwerpomgevingen ────────────────────────────────────────────
# De demo-seed wist de hele database en weigert in productie, tenzij dit op true staat.
# ALLOW_DEMO_SEED="true"
